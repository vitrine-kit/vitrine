  "name": "wishlist",
  "title": "Wishlist",
  "kitVersion": "0.0.0",
  "requiresContracts": ">=1.0.0 <2.0.0",
  "tier": ["catalog", "simple-store", "full-store"],
  "registryDependencies": ["catalog", "product-page"],
