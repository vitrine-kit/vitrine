  "config": { "set": { "features.wishlist": true } },
  "slots": [
    { "slot": "product.below-price", "component": "WishlistButton", "order": 20 },
    { "slot": "global.header-actions", "component": "WishlistIndicator", "order": 15 }
  ],
  "env": [],
  "claudeDoc": "docs/wishlist.md",
  "conflicts": [],
  "removable": true
